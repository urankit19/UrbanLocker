```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/
backend/dist/
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Coverage and test output
coverage/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/
.idea/

# Temporary files
*.tmp
*.temp

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
```
